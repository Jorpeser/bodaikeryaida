# ----------------------------------------------------------------------------
# Google Sheets RSVP integration
# ----------------------------------------------------------------------------
# RSVP submissions are appended as rows to a Google Sheet using a service
# account. To set this up:
#
# 1. Create a Google Cloud project and enable the "Google Sheets API".
# 2. Create a Service Account, then create a JSON key for it.
# 3. Create a Google Sheet. Share it (Editor) with the service account email.
# 4. Copy the values below from the JSON key + the sheet URL.
#
# If these are left empty, the RSVP form still works visually and logs the
# submission to the server console (nothing is stored).
# ----------------------------------------------------------------------------

# The service account email, e.g. rsvp-writer@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private key from the JSON file. Keep the quotes and the literal \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID — the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Optional: the tab/sheet name to append to (defaults to "RSVP")
GOOGLE_SHEET_TAB=RSVP
